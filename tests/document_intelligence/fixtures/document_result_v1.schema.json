{
  "$defs": {
    "BoundingBox": {
      "properties": {
        "x1": {
          "default": 0,
          "title": "X1",
          "type": "number"
        },
        "x2": {
          "default": 0,
          "title": "X2",
          "type": "number"
        },
        "y1": {
          "default": 0,
          "title": "Y1",
          "type": "number"
        },
        "y2": {
          "default": 0,
          "title": "Y2",
          "type": "number"
        }
      },
      "title": "BoundingBox",
      "type": "object"
    },
    "DocumentDiagnostics": {
      "properties": {
        "cache_enabled": {
          "title": "Cache Enabled",
          "type": "boolean"
        },
        "fallback_page_count": {
          "title": "Fallback Page Count",
          "type": "integer"
        },
        "missing_geometry_count": {
          "title": "Missing Geometry Count",
          "type": "integer"
        },
        "ocr_page_count": {
          "title": "Ocr Page Count",
          "type": "integer"
        },
        "processing_ms": {
          "title": "Processing Ms",
          "type": "number"
        },
        "timings_ms": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Timings Ms",
          "type": "object"
        }
      },
      "required": [
        "processing_ms",
        "timings_ms",
        "missing_geometry_count",
        "ocr_page_count",
        "fallback_page_count",
        "cache_enabled"
      ],
      "title": "DocumentDiagnostics",
      "type": "object"
    },
    "EvidenceElement": {
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundingBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "coordinate_space": {
          "const": "rendered_page_pixels",
          "default": "rendered_page_pixels",
          "title": "Coordinate Space",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "line_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Index"
        },
        "native_order": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Order"
        },
        "page_height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Height"
        },
        "page_number": {
          "title": "Page Number",
          "type": "integer"
        },
        "page_width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Width"
        },
        "source": {
          "enum": [
            "native_pdf",
            "paddleocr",
            "tesseract"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundingBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_coordinate_space": {
          "enum": [
            "pdf_unrotated_points",
            "ocr_inference_pixels"
          ],
          "title": "Source Coordinate Space",
          "type": "string"
        },
        "source_to_page": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Source To Page",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "page_number",
        "source",
        "id",
        "source_coordinate_space",
        "source_to_page"
      ],
      "title": "EvidenceElement",
      "type": "object"
    },
    "GeometryGroup": {
      "properties": {
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "element_ids": {
          "items": {
            "type": "string"
          },
          "title": "Element Ids",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "bbox",
        "element_ids"
      ],
      "title": "GeometryGroup",
      "type": "object"
    },
    "PageDiagnostics": {
      "properties": {
        "cache_hit": {
          "default": false,
          "title": "Cache Hit",
          "type": "boolean"
        },
        "fallback_used": {
          "default": false,
          "title": "Fallback Used",
          "type": "boolean"
        },
        "missing_geometry_count": {
          "default": 0,
          "title": "Missing Geometry Count",
          "type": "integer"
        },
        "native_text_available": {
          "default": false,
          "title": "Native Text Available",
          "type": "boolean"
        },
        "native_text_usable": {
          "default": false,
          "title": "Native Text Usable",
          "type": "boolean"
        },
        "ocr_used": {
          "default": false,
          "title": "Ocr Used",
          "type": "boolean"
        },
        "processing_ms": {
          "default": 0,
          "title": "Processing Ms",
          "type": "number"
        },
        "selected_path": {
          "default": "native",
          "title": "Selected Path",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "PageDiagnostics",
      "type": "object"
    },
    "PageGeometry": {
      "description": "Visual rows/cells, not semantic headers or reconstructed business rows.",
      "properties": {
        "cells": {
          "items": {
            "$ref": "#/$defs/GeometryGroup"
          },
          "title": "Cells",
          "type": "array"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/GeometryGroup"
          },
          "title": "Columns",
          "type": "array"
        },
        "coordinate_space": {
          "default": "rendered_page_pixels",
          "title": "Coordinate Space",
          "type": "string"
        },
        "method": {
          "default": "vertical_overlap_and_repeated_left_edges",
          "title": "Method",
          "type": "string"
        },
        "regions": {
          "items": {
            "$ref": "#/$defs/GeometryGroup"
          },
          "title": "Regions",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/GeometryGroup"
          },
          "title": "Rows",
          "type": "array"
        }
      },
      "title": "PageGeometry",
      "type": "object"
    },
    "PageResult": {
      "properties": {
        "coordinate_space": {
          "const": "rendered_page_pixels",
          "default": "rendered_page_pixels",
          "title": "Coordinate Space",
          "type": "string"
        },
        "diagnostics": {
          "$ref": "#/$defs/PageDiagnostics"
        },
        "elements": {
          "items": {
            "$ref": "#/$defs/EvidenceElement"
          },
          "title": "Elements",
          "type": "array"
        },
        "geometry": {
          "$ref": "#/$defs/PageGeometry"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "page_number": {
          "title": "Page Number",
          "type": "integer"
        },
        "pdf_rotation": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pdf Rotation"
        },
        "pdf_to_page": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pdf To Page"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "page_number",
        "width",
        "height"
      ],
      "title": "PageResult",
      "type": "object"
    }
  },
  "properties": {
    "diagnostics": {
      "$ref": "#/$defs/DocumentDiagnostics"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "mode": {
      "enum": [
        "auto",
        "native",
        "ocr",
        "hybrid"
      ],
      "title": "Mode",
      "type": "string"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/PageResult"
      },
      "title": "Pages",
      "type": "array"
    },
    "source_type": {
      "enum": [
        "pdf",
        "image"
      ],
      "title": "Source Type",
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "source_type",
    "mode",
    "pages",
    "diagnostics"
  ],
  "title": "DocumentResult",
  "type": "object"
}
